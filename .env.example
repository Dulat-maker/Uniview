# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.

# Contact info for the User-Agent sent to Wikimedia APIs only (a URL and/or email).
# Without it Wikimedia allows ~10 requests/min instead of ~200, and profiles fail under load.
WIKIMEDIA_CONTACT=

# Optional: where the JSON cache is written. Defaults to .cache/ locally and the temp dir on Vercel.
# UNIVIEW_CACHE_DIR=
